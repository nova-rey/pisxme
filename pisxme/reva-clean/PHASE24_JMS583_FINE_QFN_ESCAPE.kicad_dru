(version 1)
(rule "jms583 local qfn escape"
  (condition "(A.NetName == 'XIN' || A.NetName == 'XOUT' || B.NetName == 'XIN' || B.NetName == 'XOUT') && (A.Footprint == 'U11' || B.Footprint == 'U11' || A.Footprint == 'Y10' || B.Footprint == 'Y10')")
  (constraint clearance (min 0.10mm))
  (constraint track_width (min 0.10mm)))
