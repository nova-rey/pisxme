            (function() {
              if (typeof window.wpmlLSBlockKeyboard === 'undefined') {
                window.wpmlLSBlockKeyboard = true;
                document.addEventListener('DOMContentLoaded', function() {
                  var toggles = document.querySelectorAll('.wp-block-navigation-submenu__toggle[tabindex="0"]');
                  toggles.forEach(function(toggle) {
                    var isClickMode = toggle.closest('.open-on-click');
                    if (isClickMode) {
                      toggle.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter' || e.key === ' ') {
                          e.preventDefault();
                          toggle.click();
                        }
                      });
                    } else {
                      toggle.addEventListener('keydown', function(e) {
                        if (e.key === 'ArrowDown') {
                          e.preventDefault();
                          toggle.classList.add('wpml-ls-keyboard-focus');
                          var submenu = toggle.nextElementSibling;
                          if (submenu) {
                            var firstLink = submenu.querySelector('a');
                            if (firstLink) firstLink.focus();
                          }
                        } else if (e.key === 'Escape') {
                          e.preventDefault();
                          toggle.classList.remove('wpml-ls-keyboard-focus');
                        }
                      });
                      toggle.addEventListener('focus', function() {
                        toggle.classList.add('wpml-ls-keyboard-focus');
                      });
                      toggle.addEventListener('blur', function() {
                        var parent = toggle.closest('li');
                        setTimeout(function() {
                          if (parent && !parent.contains(document.activeElement)) {
                            toggle.classList.remove('wpml-ls-keyboard-focus');
                          }
                        }, 100);
                      });
                      document.addEventListener('click', function(e) {
                        var dropdown = toggle.closest('.wpml-ls-dropdown');
                        if (dropdown && !dropdown.contains(e.target)) {
                          toggle.classList.remove('wpml-ls-keyboard-focus');
                        }
                      });
                    }
                  });
                });
              }
            })();
          </script><ul class="wp-block-navigation__container"><li class="wp-block-navigation-item has-child wp-block-navigation-submenu open-on-click" onclick="(()=&gt;{const ariaExpanded = this.children[0].getAttribute('aria-expanded');
